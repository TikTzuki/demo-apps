generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(200)
  tag         String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rooms           MeetingRoom[]
  telegramGroups  TelegramGroup[]
  discordChannels DiscordChannel[]

  @@map("organizations")
}

model TelegramGroup {
  id             String   @id @default(uuid())
  chatId         String   @map("chat_id") @db.VarChar(100)
  chatTitle      String?  @map("chat_title") @db.VarChar(200)
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([chatId, organizationId])
  @@map("telegram_groups")
}

model DiscordChannel {
  id             String   @id @default(uuid())
  channelId      String   @map("channel_id") @db.VarChar(100)
  guildId        String   @map("guild_id") @db.VarChar(100)
  guildName      String?  @map("guild_name") @db.VarChar(200)
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([channelId, organizationId])
  @@map("discord_channels")
}

model MeetingRoom {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(200)
  capacity       Int      @default(0)
  location       String?  @db.VarChar(200)
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@map("meeting_rooms")
}

model Booking {
  id         String   @id @default(uuid())
  bookerName String   @map("booker_name") @db.VarChar(100)
  startTime  DateTime @map("start_time")
  endTime    DateTime @map("end_time")
  roomId     String   @map("room_id")
  createdAt  DateTime @default(now()) @map("created_at")

  room MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startTime, endTime])
  @@map("bookings")
}
