# Database — expects a dedicated database, using the default `public` schema.
#
# Do NOT point this at a non-public schema without a code change: `prisma migrate`
# honours `?schema=`, but the pg driver adapter in src/lib/prisma.ts ignores it,
# so migrations would land in one schema while the app queried `public`. Setting
# it requires passing {schema} to the PrismaPg constructor as well.
#
# URL-encode special characters in the password (# -> %23, @ -> %40), otherwise
# the rest of the URL is misparsed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/checkin?schema=public

# Admin account seeded at startup (idempotent — see prisma/seed-admin.ts).
# The password is only used the first time the account is created; rotating it
# afterwards is done through the app, not by editing this value.
ADMIN_EMAIL=admin@newera.inc
ADMIN_NAME=Quản trị viên
ADMIN_PASSWORD=

# Signing key for the admin session cookie. Minimum 32 characters.
# Generate with: openssl rand -base64 48
AUTH_SECRET=
